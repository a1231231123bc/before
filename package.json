    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "export:web": "expo export --platform web",
    "check": "npm run lint && npm run typecheck && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "expo lint",
    "build:video": "node scripts/build-video-renderer.mjs",
    "postinstall": "npm run build:video",
    "prestart": "npm run build:video",
    "preweb": "npm run build:video",
    "preios": "npm run build:video",
    "preandroid": "npm run build:video",
    "precheck": "npm run build:video",
    "preexport:web": "npm run build:video"
  },
  "private": true,
  "description": "An offline photo journal for seeing how far you have come.",
  "engines": {
    "node": ">=24.3.0"
  }
