{
  "expo": {
    "name": "Frameago",
    "slug": "before",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "before",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.a1231231123bc.before",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.a1231231123bc.before",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F7F5EF"
      },
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/icon.png",
      "name": "Frameago — Your progress journal",
      "description": "Small moments. Visible progress. A private photo journal.",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos to keep in your private Frameago journal.",
          "cameraPermission": "Take photos to document your progress in Frameago.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F5EF",
          "image": "./assets/icon.png",
          "imageWidth": 160
        }
      ],
      "expo-asset",
      "expo-router",
      [
        "expo-media-library",
        {
          "photosPermission": "Choose photos to keep in your private Frameago journal.",
          "savePhotosPermission": "Save your Frameago progress videos to Photos to share them on Instagram.",
          "granularPermissions": [],
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e259c79c-d0dd-4a06-aa1f-abf38ccec722"
      }
    },
    "owner": "pavel667"
  }
}
