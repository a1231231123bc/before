{
  "expo": {
    "name": "Before",
    "slug": "before",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "before",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.a1231231123bc.before",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.a1231231123bc.before",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F7F5EF"
      },
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/icon.png",
      "name": "Before \u2014 Your progress journal",
      "description": "Small moments. Visible progress. A private photo journal.",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos to keep in your private Before journal.",
          "cameraPermission": "Take photos to document your progress in Before.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F5EF",
          "image": "./assets/icon.png",
          "imageWidth": 160
        }
      ],
      "expo-asset",
      "expo-router"
    ]
  }
}
